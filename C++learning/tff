void handle_smc(struct cpu_rec *rec, struct smc_ret *ret)
{
    unsigned long fid = rec->regs.x0;
    // 总分发RMI命令
    ret->ret = rmi_dispatch(fid, &rec->regs, &rec->regs);
}
 
 
