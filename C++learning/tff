阶段2：OLK6.6 KVM侧创建Realm代理，并发起RMI_REALM_CREATE
 
2.1 arch/arm64/kvm/cca/realm.c
 
c
  
int kvm_cca_create_realm(struct kvm *kvm)
{
    struct kvm_realm *kr = kvm->arch.krealm;
    struct rmi_realm_create_args send;
    struct rmi_realm_create_ret recv;

    // 填充IPA大小、GICv3、PMU、RMI版本等硬件参数
    send.ipa_size = kr->ipa_bits;
    send.gic_version = GICv3;

    // 调用SMC封装层
    ret = rmi_invoke(RMI_REALM_CREATE, &send, &recv);
    // recv返回TF-RMM侧realm物理句柄，保存到kvm_realm
    kr->rmm_realm_handle = recv.realm_handle;
    return ret;
}
 
 
2.2 RMI底层SMC封装 arch/arm64/kvm/cca/rmi_smc.c
 
c
  
int rmi_invoke(unsigned long fid, struct rmi_send *send, struct rmi_recv *recv)
{
    struct arm_smccc_res res;
    u64 a1~a7;
    // 将RMI结构体参数平铺到x0~x7通用寄存器
    pack_rmi_args(send, &a1, &a2, &a3, &a4, &a5, &a6, &a7);
    // 触发SMC异常，陷入EL3
    arm_smccc_smc(fid, a1,a2,a3,a4,a5,a6,a7, &res);
    // 把返回寄存器解包
    unpack_rmi_ret(&res, recv);
    return res.a0;
}
 
 
硬件行为
 
执行 smc #0 指令，CPU从NS EL2进入EL3异常级别；硬件自动冻结当前流水线，保存PSTATE、通用寄存器，跳转到TF-A BL31 SMC异常向量。
 
阶段3：TF-A EL3 SMC路由（trusted-firmware-a）
 
bl31/services/rmm_svc.c
 
c
  
uint64_t rmm_svc_handler(uint32_t smc_fid,
        u_register_t x1, u_register_t x2,
        u_register_t x3, u_register_t x4,
        u_register_t x5, u_register_t x6, u_register_t x7)
{
    // 判断FID属于RMI标准区间
    if (is_rmi_fid(smc_fid)) {
        // SCR_EL3.NS=0 切入Secure世界
        scr_el3 = read_scr_el3();
        scr_el3 &= ~SCR_NS_BIT;
        write_scr_el3(scr_el3);

        // 跳转到TF-RMM预设SMC入口地址
        eret_to_rmm(x0,x1,x2,x3,x4,x5,x6,x7);
    }
}
 
 
关键EL3寄存器：
 
-  SCR_EL3.NS ：0=Secure，1=Non-Secure；
-  RMR_EL3 ：存放TF-RMM Secure EL2运行基地址。
 
