int kvm_cca_rec_run(struct kvm_rec *krec)
{
    struct rmi_rec_enter_args send = {
        .rec_handle = krec->rmm_rec_handle,
    };
    // 发起RMI_REC_ENTER进入机密vCPU
    rmi_invoke(RMI_REC_ENTER, &send, &recv);
    // 异常返回后处理退出原因
    return recv.exit_reason;
}
 
 
7.3 TF-RMM core/rec.c C层跳转准备
 
c
  
int rec_enter(struct rec *rec)
{
    // 设定Realm复位入口（OVMF固件 0x80000000）
    rec->state.elr_el2 = REALM_RESET_PC;
    // 设置EL1 AArch64 PSTATE
    rec->state.spsr_el2 = PSTATE_EL1_A64;
    // 跳入汇编切换入口
    return __rec_enter(rec);
}
 
 
两个核心跳转寄存器：
 
-  ELR_EL2 ：eret之后的执行PC；
-  SPSR_EL2 ：eret之后目标异常级PSTATE。
 
7.4 tf-rmm/arch/arm64/hyp/entry.S 逐行带功能注释（最核心底层跳转）
 
asm
  
// 入参 x0 = 当前REC结构体指针
__rec_enter:
    // 1.保存Secure EL2宿主通用寄存器现场到栈
    stp     x19, x20, [sp, #-16]!

    // 2.从REC影子结构体加载EL2虚拟化硬件寄存器
    // HCR_EL2、VTTBR0_EL2
    bl      arch_rec_load_el2_sysregs
    // 伪代码内部：
    // ldr x1, [x0, #REC_HCR_OFFSET]
    // msr HCR_EL2, x1
    // ldr x2, [x0, #REC_VTTBR_OFFSET]
    // msr VTTBR0_EL2, x2

    // 3.批量加载全部Realm EL1系统影子寄存器
    bl      arch_rec_load_el1_sysregs
    // msr SCTLR_EL1/TCR_EL1/TTBR0_EL1/MAIR_EL1

    // 4.加载eret跳转地址 ELR_EL2
    ldr     x1, [x0, #REC_ELR_OFFSET]
    msr     ELR_EL2, x1
    // 5.加载目标特权状态 SPSR_EL2
    ldr     x2, [x0, #REC_SPSR_OFFSET]
    msr     SPSR_EL2, x2

    // 6.ARM64硬件特权级切换指令
    eret
 
 
7.5 eret硬件全自动硬件行为
 
1.  SPSR_EL2 拷贝至Realm EL1 PSTATE；
2. PC =  ELR_EL2 ，开始执行OVMF UEFI第一条指令；
3. 运行层级：Secure EL2 → Realm EL1；
4. 双MMU同时开启：
- Stage1：Realm内核TTBR0_EL1 VA→IPA；
- Stage2：RMM VTTBR0_EL2 IPA→HPA。
 
阶段8：Realm异常陷阱返回Secure EL2 RMM
 
8.1 捕获入口 arch/arm64/vectors.S Secure EL2异常向量
 
MMIO、缺页、虚拟中断、SMC都会落入对应向量。
硬件自动保存：
 
- 当前PC → ELR_EL2
- 当前PSTATE → SPSR_EL2
 
8.2 保存客户机现场 arch/arm64/cpu/rec_state.c
 
asm
  
arch_rec_save_el1_sysregs:
    mrs x0, SCTLR_EL1
    str x0, [x_rec, #REC_SCTLR_EL1]
    // 依次保存所有EL1寄存器回REC影子
 
 
8.3 异常分发 arch/arm64/hyp/exit.c
 
根据exit_reason：MMIO缺页、虚拟中断、Stage2故障，通过RMI原路回复Host KVM，交由QEMU设备模拟。
 
